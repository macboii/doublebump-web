# Cloudflare Pages headers — Universal Links 파일은 리다이렉트 없이 application/json 이어야 한다
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600

# Android App Links (doublebump.com/card/*) — 리다이렉트 없이 application/json
/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=3600
